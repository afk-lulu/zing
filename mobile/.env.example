# Base URL of the Zing API (the `api/` Next.js app on Vercel).
# EXPO_PUBLIC_ vars are inlined into the JS bundle, so keep secrets out of here —
# ANTHROPIC / FAL / ELEVENLABS keys live only on Vercel.
#
# Local dev with `npx expo start --tunnel`: point this at a tunnelled dev server
# or your Vercel preview URL. `localhost` will not resolve from a phone.
EXPO_PUBLIC_ZING_API_URL=https://your-zing-api.vercel.app
