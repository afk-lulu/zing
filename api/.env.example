# Template only — this file IS committed. Copy it to `.env.local` and put real
# values there; `.env.local` is gitignored, this file is not.
#
#   cp .env.example .env.local

# --- Offline mock mode (no keys, no spend) ---
# Unset  → real Claude / fal / ElevenLabs (needs the keys below).
# 1      → every agent and asset call is stubbed; the full four-stage pipeline
#          still runs, including JSON extraction, Zod validation and assembly.
# chaos  → same, plus deliberate failures (a writer answering in prose, an
#          out-of-range answer key, a dead fal call, a dead ElevenLabs call) to
#          exercise the drop-and-degrade paths from ARCH §7.
ZING_MOCK=

# --- Anthropic (Extractor / Researcher / Planner / Writers / Encourager) ---
ANTHROPIC_API_KEY=

# --- fal.ai (Flux schnell, 720x1280 portrait slide images) ---
FAL_KEY=

# --- ElevenLabs (eleven_flash_v2_5, one clip per slide) ---
ELEVENLABS_API_KEY=
# Teacher voice pool, comma-separated. One is drawn at random per batch and
# every slide in that batch reuses it, so a batch always sounds like a single
# person (ARCH §2.S4) while consecutive demo runs get different teachers.
# Default pool below is "Rachel" and "Adam"; list one id to pin the narrator.
ELEVENLABS_VOICE_IDS=21m00Tcm4TlvDq8ikWAM,pNInz6obpgDQGcFmaJgB

# --- Vercel Blob (strongly recommended) ---
# When set, ElevenLabs mp3 bytes are pushed to Blob and the app receives plain URLs.
# When unset, /api/assets falls back to inline base64 data-URIs (the POC path from
# ARCH 2.S4) — but iOS AVPlayer, which backs expo-audio, does not reliably play
# `data:` URIs. Without a token, expect the batch to run silent with captions.
BLOB_READ_WRITE_TOKEN=
